# Не публикуются на GitHub (решение заказчика 03.10). Файлы остаются на
# машине — пушит их скрипт scripts/push.sh, который читает список исходников
# из tests/build_tests.bat, а прогоны идут через tests\build_tests.bat.
# docs/ — планы, спеки, агенты; spike/ — разовые пробы API EPLAN;
# tests/ — консольный раннер (16 наборов); .opencode/ — локальные скиллы.
docs/
spike/
tests/
test/

